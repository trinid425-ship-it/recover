# ── Whop app credentials ────────────────────────────────────────────────
# Create an app at https://whop.com/dashboard/developer (App API keys).
WHOP_API_KEY=
# Webhook signing secret — copy from the webhook you create in the dashboard.
WHOP_WEBHOOK_SECRET=
# Your app id (app_xxx).
WHOP_APP_ID=

# ── App config ──────────────────────────────────────────────────────────
# Public base URL where this app is deployed (used to build update-card links).
APP_BASE_URL=http://localhost:3000
# Secret to authorize the cron processor endpoint (Authorization: Bearer <this>).
CRON_SECRET=
# "mock" = log messages locally, don't call Whop. "whop" = live sending.
MESSENGER_MODE=mock
